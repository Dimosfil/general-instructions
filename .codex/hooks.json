{
  "description": "GI mandatory context and automatic final review. Review and trust this definition in Codex.",
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{
      "type": "command",
      "command": "pwsh -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/tools/invoke-gi-lifecycle-hook.ps1\"",
      "commandWindows": "pwsh -NoProfile -NonInteractive -Command \"& (Join-Path (git rev-parse --show-toplevel) 'tools/invoke-gi-lifecycle-hook.ps1')\"",
      "timeout": 30,
      "statusMessage": "Loading mandatory GI rules"
    }] }],
    "SessionStart": [{ "matcher": "^compact$", "hooks": [{
      "type": "command",
      "command": "pwsh -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/tools/invoke-gi-lifecycle-hook.ps1\"",
      "commandWindows": "pwsh -NoProfile -NonInteractive -Command \"& (Join-Path (git rev-parse --show-toplevel) 'tools/invoke-gi-lifecycle-hook.ps1')\"",
      "timeout": 30,
      "statusMessage": "Restoring mandatory GI rules after compaction"
    }] }],
    "Stop": [{ "hooks": [{
      "type": "command",
      "command": "pwsh -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/tools/invoke-gi-lifecycle-hook.ps1\"",
      "commandWindows": "pwsh -NoProfile -NonInteractive -Command \"& (Join-Path (git rev-parse --show-toplevel) 'tools/invoke-gi-lifecycle-hook.ps1')\"",
      "timeout": 30,
      "statusMessage": "Checking task completion automatically"
    }] }]
  }
}
